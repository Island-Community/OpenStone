#include <winver.h>

#define COLD_PAYLOAD_ID 5001
COLD_PAYLOAD_ID RCDATA "@COLD_PAYLOAD_DLL@"

@COLD_SCRIPT_RC_LINES@
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1, 0, 0, 0
 PRODUCTVERSION 1, 0, 0, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Island Community"
            VALUE "FileDescription", "Stone loader"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "stone-injector"
            VALUE "OriginalFilename", "stone-injector.exe"
            VALUE "ProductName", "Stone"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
