if(NOT EXISTS "${COLD_DLL}")
    message(FATAL_ERROR "payload DLL not built yet: ${COLD_DLL}")
endif()

file(GLOB _scripts "${COLD_SCRIPTS_DIR}/*.lua")
list(SORT _scripts)

file(SHA256 "${COLD_DLL}" _dll_hash)
set(_key "${_dll_hash}\n")
foreach(_script IN LISTS _scripts)
    get_filename_component(_name "${_script}" NAME)
    file(SHA256 "${_script}" _script_hash)
    string(APPEND _key "${_name}=${_script_hash}\n")
endforeach()

set(_old "")
if(EXISTS "${COLD_STAMP}")
    file(READ "${COLD_STAMP}" _old)
endif()
if(_old STREQUAL _key AND EXISTS "${COLD_RC_OUT}" AND EXISTS "${COLD_HPP_OUT}")
    return()
endif()

set(_rc_lines "")
set(_table "")
set(_id 5100)
foreach(_script IN LISTS _scripts)
    get_filename_component(_name "${_script}" NAME)
    string(APPEND _rc_lines "${_id} RCDATA \"${_script}\"\n")
    string(APPEND _table "    {${_id}, \"${_name}\"},\n")
    math(EXPR _id "${_id}+1")
endforeach()

file(READ "${COLD_RC_IN}" _rc_template)
string(REPLACE "@COLD_PAYLOAD_DLL@" "${COLD_DLL}" _rc_out "${_rc_template}")
string(REPLACE "@COLD_SCRIPT_RC_LINES@" "${_rc_lines}" _rc_out "${_rc_out}")
file(WRITE "${COLD_RC_OUT}" "${_rc_out}")

file(READ "${COLD_HPP_IN}" _hpp_template)
string(REPLACE "@COLD_SCRIPT_TABLE@" "${_table}" _hpp_out "${_hpp_template}")
file(WRITE "${COLD_HPP_OUT}" "${_hpp_out}")

file(WRITE "${COLD_STAMP}" "${_key}")
message(STATUS "loader embed refreshed")
